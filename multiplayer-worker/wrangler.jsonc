{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "byzantine-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PILGRIM_ROOMS",
        "class_name": "PilgrimRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PilgrimRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
